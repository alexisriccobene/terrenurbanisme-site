{
 "mailer_subjects_recovery": "Choisissez votre mot de passe TerrenUrbanisme",
 "mailer_templates_recovery_content": "<!doctype html><html lang=\"fr\"><body style=\"margin:0;background:#F9F2EE;font-family:Helvetica,Arial,sans-serif;color:#2A1D17\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#F9F2EE;padding:32px 12px\"><tr><td align=\"center\">\n<table role=\"presentation\" width=\"560\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:560px;width:100%;background:#ffffff;border:1px solid #EFE6DF;border-radius:16px\">\n<tr><td style=\"padding:28px 32px 8px\"><span style=\"font-size:18px;font-weight:700;color:#2A1D17\">TerrenUrbanisme</span></td></tr>\n<tr><td style=\"padding:8px 32px 0\"><h1 style=\"font-size:22px;line-height:1.3;margin:0 0 12px\">Choisissez votre mot de passe</h1>\n<p style=\"font-size:15px;line-height:1.6;margin:0 0 22px\">Cliquez sur le bouton ci-dessous pour choisir votre mot de passe et accéder à votre espace TerrenUrbanisme, où vous retrouvez tous vos rapports.</p>\n<p style=\"margin:0 0 26px\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#A3462C;color:#ffffff;text-decoration:none;font-weight:700;font-size:15px;padding:13px 22px;border-radius:12px\">Choisir mon mot de passe</a></p>\n<p style=\"font-size:13px;line-height:1.6;color:#6E625A;margin:0 0 24px\">Ce lien est valable une heure. Si vous n'êtes pas à l'origine de cette demande, ignorez simplement cet e-mail.</p></td></tr>\n<tr><td style=\"padding:18px 32px 28px;font-size:12px;color:#8A7D74;border-top:1px solid #EFE6DF\">TerrenUrbanisme · terrenurbanisme.com · contact@terrenurbanisme.com</td></tr>\n</table></td></tr></table></body></html>",
 "mailer_subjects_confirmation": "Confirmez votre adresse e-mail",
 "mailer_templates_confirmation_content": "<!doctype html><html lang=\"fr\"><body style=\"margin:0;background:#F9F2EE;font-family:Helvetica,Arial,sans-serif;color:#2A1D17\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#F9F2EE;padding:32px 12px\"><tr><td align=\"center\">\n<table role=\"presentation\" width=\"560\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:560px;width:100%;background:#ffffff;border:1px solid #EFE6DF;border-radius:16px\">\n<tr><td style=\"padding:28px 32px 8px\"><span style=\"font-size:18px;font-weight:700;color:#2A1D17\">TerrenUrbanisme</span></td></tr>\n<tr><td style=\"padding:8px 32px 0\"><h1 style=\"font-size:22px;line-height:1.3;margin:0 0 12px\">Bienvenue sur TerrenUrbanisme</h1>\n<p style=\"font-size:15px;line-height:1.6;margin:0 0 22px\">Confirmez votre adresse e-mail pour activer votre compte et accéder à votre espace.</p>\n<p style=\"margin:0 0 26px\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#A3462C;color:#ffffff;text-decoration:none;font-weight:700;font-size:15px;padding:13px 22px;border-radius:12px\">Confirmer mon adresse</a></p>\n<p style=\"font-size:13px;line-height:1.6;color:#6E625A;margin:0 0 24px\">Si vous n'avez pas créé de compte, ignorez simplement cet e-mail.</p></td></tr>\n<tr><td style=\"padding:18px 32px 28px;font-size:12px;color:#8A7D74;border-top:1px solid #EFE6DF\">TerrenUrbanisme · terrenurbanisme.com · contact@terrenurbanisme.com</td></tr>\n</table></td></tr></table></body></html>",
 "mailer_subjects_magic_link": "Votre lien de connexion TerrenUrbanisme",
 "mailer_templates_magic_link_content": "<!doctype html><html lang=\"fr\"><body style=\"margin:0;background:#F9F2EE;font-family:Helvetica,Arial,sans-serif;color:#2A1D17\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#F9F2EE;padding:32px 12px\"><tr><td align=\"center\">\n<table role=\"presentation\" width=\"560\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:560px;width:100%;background:#ffffff;border:1px solid #EFE6DF;border-radius:16px\">\n<tr><td style=\"padding:28px 32px 8px\"><span style=\"font-size:18px;font-weight:700;color:#2A1D17\">TerrenUrbanisme</span></td></tr>\n<tr><td style=\"padding:8px 32px 0\"><h1 style=\"font-size:22px;line-height:1.3;margin:0 0 12px\">Votre lien de connexion</h1>\n<p style=\"font-size:15px;line-height:1.6;margin:0 0 22px\">Cliquez sur le bouton ci-dessous pour ouvrir votre espace TerrenUrbanisme.</p>\n<p style=\"margin:0 0 26px\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#A3462C;color:#ffffff;text-decoration:none;font-weight:700;font-size:15px;padding:13px 22px;border-radius:12px\">Ouvrir mon espace</a></p>\n<p style=\"font-size:13px;line-height:1.6;color:#6E625A;margin:0 0 24px\">Ce lien est valable une heure et ne peut servir qu'une fois. Si vous n'êtes pas à l'origine de cette demande, ignorez cet e-mail.</p></td></tr>\n<tr><td style=\"padding:18px 32px 28px;font-size:12px;color:#8A7D74;border-top:1px solid #EFE6DF\">TerrenUrbanisme · terrenurbanisme.com · contact@terrenurbanisme.com</td></tr>\n</table></td></tr></table></body></html>",
 "mailer_subjects_email_change": "Confirmez votre nouvelle adresse e-mail",
 "mailer_templates_email_change_content": "<!doctype html><html lang=\"fr\"><body style=\"margin:0;background:#F9F2EE;font-family:Helvetica,Arial,sans-serif;color:#2A1D17\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#F9F2EE;padding:32px 12px\"><tr><td align=\"center\">\n<table role=\"presentation\" width=\"560\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:560px;width:100%;background:#ffffff;border:1px solid #EFE6DF;border-radius:16px\">\n<tr><td style=\"padding:28px 32px 8px\"><span style=\"font-size:18px;font-weight:700;color:#2A1D17\">TerrenUrbanisme</span></td></tr>\n<tr><td style=\"padding:8px 32px 0\"><h1 style=\"font-size:22px;line-height:1.3;margin:0 0 12px\">Changement d'adresse e-mail</h1>\n<p style=\"font-size:15px;line-height:1.6;margin:0 0 22px\">Confirmez votre nouvelle adresse e-mail pour votre compte TerrenUrbanisme.</p>\n<p style=\"margin:0 0 26px\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#A3462C;color:#ffffff;text-decoration:none;font-weight:700;font-size:15px;padding:13px 22px;border-radius:12px\">Confirmer la nouvelle adresse</a></p>\n<p style=\"font-size:13px;line-height:1.6;color:#6E625A;margin:0 0 24px\">Si vous n'êtes pas à l'origine de cette demande, contactez-nous à contact@terrenurbanisme.com.</p></td></tr>\n<tr><td style=\"padding:18px 32px 28px;font-size:12px;color:#8A7D74;border-top:1px solid #EFE6DF\">TerrenUrbanisme · terrenurbanisme.com · contact@terrenurbanisme.com</td></tr>\n</table></td></tr></table></body></html>",
 "mailer_subjects_invite": "Votre accès TerrenUrbanisme",
 "mailer_templates_invite_content": "<!doctype html><html lang=\"fr\"><body style=\"margin:0;background:#F9F2EE;font-family:Helvetica,Arial,sans-serif;color:#2A1D17\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#F9F2EE;padding:32px 12px\"><tr><td align=\"center\">\n<table role=\"presentation\" width=\"560\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:560px;width:100%;background:#ffffff;border:1px solid #EFE6DF;border-radius:16px\">\n<tr><td style=\"padding:28px 32px 8px\"><span style=\"font-size:18px;font-weight:700;color:#2A1D17\">TerrenUrbanisme</span></td></tr>\n<tr><td style=\"padding:8px 32px 0\"><h1 style=\"font-size:22px;line-height:1.3;margin:0 0 12px\">Votre accès TerrenUrbanisme</h1>\n<p style=\"font-size:15px;line-height:1.6;margin:0 0 22px\">Un espace TerrenUrbanisme a été créé pour vous. Cliquez sur le bouton ci-dessous pour l'activer.</p>\n<p style=\"margin:0 0 26px\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#A3462C;color:#ffffff;text-decoration:none;font-weight:700;font-size:15px;padding:13px 22px;border-radius:12px\">Activer mon espace</a></p>\n<p style=\"font-size:13px;line-height:1.6;color:#6E625A;margin:0 0 24px\">Si vous ne vous attendiez pas à cet e-mail, ignorez-le simplement.</p></td></tr>\n<tr><td style=\"padding:18px 32px 28px;font-size:12px;color:#8A7D74;border-top:1px solid #EFE6DF\">TerrenUrbanisme · terrenurbanisme.com · contact@terrenurbanisme.com</td></tr>\n</table></td></tr></table></body></html>"
